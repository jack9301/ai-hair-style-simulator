{
  // Cloudflare Workers / Pages config for the AI Hairstyle Simulator.
  // Keep this in sync with the bindings your app reads at runtime
  // (DATABASE_URL is supplied as a secret, see DEPLOY.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-hair-style-simulator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_v2"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // NEXTAUTH_URL is read at build & runtime; override in the dashboard for production.
    "NEXTAUTH_URL": "http://localhost:3000",
    "WEBHOOK_URL": "http://localhost:3000"
  }
  // Secrets (set via `wrangler secret put NAME` or Cloudflare dashboard, never commit them):
  //   DATABASE_URL
  //   NEXTAUTH_SECRET
  //   GOOGLE_CLIENT_ID
  //   GOOGLE_CLIENT_SECRET
  //   STRIPE_SECRET_KEY
  //   STRIPE_WEBHOOK_SECRET
  //   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
  //   MUAPIAPP_API_KEY
}
